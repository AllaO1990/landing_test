{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"moduleResolution": "node",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "es2015",
		"module": "esnext",
		"lib": ["es2020", "dom"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@core/*": ["desktop-page/core/*"],
			"@data-access-deal/*": ["desktop-page/deal/data-access/src/lib/data-access/*"],
			"@data-access-idea/*": ["desktop-page/ideas/data-access/src/lib/data-access/*"],
			"@data-access-main/*": ["desktop-page/main/data-access/src/lib/data-access/*"],
			"@data-access-portfolio/*": ["desktop-page/portfolio/data-access/src/lib/data-access/*"],
			"@data-access-stock/*": ["desktop-page/stock/data-access/src/lib/data-access/*"],
			"@data-access-structure/*": ["dist/structure/data-access", "desktop-page/structure/data-access/src/index.ts"],
			"@data-access-trade/*": ["desktop-page/trade/data-access/src/lib/data-access/*"],
			"@desktop-data/*": ["api/desktop-data/src/lib/*"],
			"@feat-deal-list": ["desktop-page/ideas/feat-deals/src/index.ts"],
			"@feat-idea-list": ["desktop-page/ideas/feat-ideas/src/index.ts"],
			"@feat-portfolio-balance": ["desktop-page/portfolio/feat-balance/src/index.ts"],
			"@feat-portfolio-chart": ["desktop-page/portfolio/feat-chart/feat-chart/src/index.ts"],
			"@feat-portfolio-list": ["desktop-page/portfolio/feat-list/src/index.ts"],
			"@feat-structure": ["desktop-page/structure/feat-structure/src/index.ts"],
			"@feat-trade-limit": ["desktop-page/trade/feat-limit/src/index.ts"],
			"@feat-trade-token": ["desktop-page/trade/feat-token/src/index.ts"],
			"@ui-portfolio-common/*": ["desktop-page/portfolio/ui-common/src/lib/*"],
			"@ui/animations/*": ["ui/src/lib/animations/*"],
			"@ui/components/*": ["ui/src/lib/ui/*"],
			"@ui/pipes/*": ["ui/src/lib/pipe/*"],
			"constants/*": ["constants/*"],
			"dashboard": ["desktop-page/dashboard/src/index.ts"],
			"data-access": ["desktop-page/stock/data-access/src/index.ts"],
			"desktop-page/enter": ["desktop-page/enter/src/index.ts"],
			"desktop-page/trade": ["desktop-page/trade/src/index.ts"],
			"feat-candlestick": ["desktop-page/stock/feat-candlestick/src/index.ts"],
			"feat-instrument": ["desktop-page/stock/feat-instrument/src/index.ts"],
			"feat-limit": ["desktop-page/portfolio/feat-limit/src/index.ts"],
			"feat-view": ["desktop-page/trade/feat-view/src/index.ts"],
			"light": ["desktop-page/light/feat-light/src/index.ts"],
			"lk": ["desktop-page/lk/src/index.ts"],
			"login": ["desktop-page/login/src/index.ts"],
			"main": ["desktop-page/main/src/index.ts"],
			"page-401": ["page-401/src/index.ts"],
			"page-403": ["page-403/src/index.ts"],
			"page-404": ["page-404/src/index.ts"],
			"payment": ["desktop-page/payment/src/index.ts"],
			"portfolio": ["desktop-page/portfolio/src/index.ts"],
			"pro": ["desktop-page/pro/feat-pro/src/index.ts"],
			"registration": ["desktop-page/registration/src/index.ts"],
			"sale": ["desktop-page/sale/src/index.ts"],
			"settings": ["desktop-page/settings/src/index.ts"],
			"shall": ["desktop-page/shall/src/index.ts"],
			"stock": ["desktop-page/stock/src/index.ts"],
			"storage/*": ["stores/local/*"],
			"stores/*": ["stores/desktop/*"],
			"tokens/*": ["tokens/*"],
			"types/*": ["types/*"],
			"ui-common/*": ["ui-common/src/*"],
			"utils/*": ["utils/*"]
		}
	},
	"angularCompilerOptions": {
		"enableI18nLegacyMessageIdFormat": false,
		"strictInjectionParameters": false,
		"strictInputAccessModifiers": false,
		"strictTemplates": false,
		"strictInputTypes": false,
		"strictNullInputTypes": false,
		"strictAttributeTypes": false,
		"strictSafeNavigationTypes": false,
		"strictDomLocalRefTypes": false,
		"strictOutputEventTypes": false,
		"strictDomEventTypes": false,
		"strictContextGenerics": false,
		"strictLiteralTypes": true
	},
	"exclude": ["node_modules", "tmp"]
}
