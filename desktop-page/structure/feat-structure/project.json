{
  "name": "feat-structure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "desktop-page/structure/feat-structure/src",
  "prefix": "structure",
  "projectType": "library",
  "tags": [
    "structure"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "desktop-page/structure/feat-structure/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "generators": {
    "@schematics/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush"
    }
  }
